<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <PackageId>UniFi.Network.Client</PackageId>
    <Version>10.4.57</Version>
    <Description>A .NET client for the UniFi Network API, supporting both local console and Site Manager cloud connector access.</Description>
    <Authors>Daniël van Ginneken</Authors>
    <RepositoryUrl>https://github.com/DanielvG-IT/UniFi.NET</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>